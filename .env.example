# Your Pool Mate — environment variables
# Copy this file to `.env.local` and fill in real values for local dev.
# Cloudflare Pages reads its own copy from the dashboard
# (Settings → Environment variables, Production + Preview scopes).
#
# All Vite-injected env vars MUST be prefixed `VITE_` to be exposed to
# the browser bundle.
#
# NOTE: The current App.jsx is UI-only and does not call Supabase at
# runtime yet, so these are not strictly required to run the app
# locally. They're here ready for when auth + persistence are wired up.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# One-tap sign-in buttons shown on the sign-up and sign-in screens.
# Comma-separated; supported: google, apple. Leave blank for email only.
# Only list a provider AFTER it is enabled in the Supabase dashboard
# (Authentication → Providers) — see docs/SOCIAL_SIGNIN_SETUP.md.
VITE_AUTH_PROVIDERS=
